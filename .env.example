# ============================================================================
# Madinah Market — environment variables (copy this file to ".env.local"
# for local development, or paste the same names/values into Vercel).
# NEVER share real secret values. NEVER commit .env.local to git.
# ============================================================================

# Public URL of this website (no trailing slash).
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings -> API in your Supabase dashboard) ----------
# Public project URL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public "anon" key — safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# SECRET "service_role" key — SERVER ONLY. It can read/write every order.
# Never put it in browser code, never share it, never send it in chat.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Stripe (Dashboard -> Developers -> API keys) ---------------------------
# SECRET key. Leave EMPTY to run the whole site in TEST MODE
# (orders are marked "test_paid" with no real charge).
STRIPE_SECRET_KEY=
# Public "publishable" key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE-ME
# SECRET webhook signing secret (Dashboard -> Developers -> Webhooks,
# created for the endpoint https://your-domain.com/api/stripe-webhook).
STRIPE_WEBHOOK_SECRET=whsec_REPLACE-ME

# --- Shipday (Shipday dashboard -> Integrations -> API Credentials) ---------
# SECRET API key — server only. Leave empty to disable driver dispatch.
SHIPDAY_API_KEY=
# Shared secret token YOU invent and also paste into Shipday's webhook
# settings, so only Shipday can call /api/shipday-webhook.
SHIPDAY_WEBHOOK_TOKEN=REPLACE-WITH-A-LONG-RANDOM-TOKEN

# --- Owner notification ------------------------------------------------------
# Every paid / test-paid order is emailed to this address.
OWNER_NOTIFICATION_EMAIL=Abdolsami@yahoo.com
# OPTIONAL email sending API (for example Resend): if both are set, owner
# emails are sent through it. If empty, order emails are written to the
# server log instead (best-effort; email never blocks an order).
EMAIL_API_URL=
EMAIL_API_KEY=

# --- Business rules ----------------------------------------------------------
TAX_RATE=0.08
RESTAURANT_LAT=39.65987
RESTAURANT_LNG=-104.85051

# TV board test mode: "true" shows ALL recent orders on /display (testing
# only). MUST be "false" for real customers (paid orders, last 4 hours only).
NEXT_PUBLIC_BOARD_TEST_MODE=false
